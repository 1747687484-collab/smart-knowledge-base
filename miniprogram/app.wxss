/* ========== 主题变量 ========== */
page {
  --bg-page: #f5f7fb;
  --bg-card: #ffffff;
  --bg-hero: linear-gradient(135deg, #eef2ff 0%, #f8fbff 100%);
  --bg-chip: #eef2ff;
  --bg-ghost: #eef2ff;
  --bg-tab: #eef2ff;
  --bg-input: #ffffff;
  --bg-step: #eef2ff;
  --bg-tag: #ecfeff;
  --bg-feature1: #eef2ff;
  --bg-feature2: #ecfeff;
  --bg-feature3: #f5f3ff;
  --bg-feature4: #fef3c7;
  --bg-divider: #e5e7eb;
  --bg-border: #e5e7eb;
  --bg-chunk-border: #f3f4f6;
  --color-primary: #2563eb;
  --color-text: #1f2937;
  --color-text-bold: #111827;
  --color-subtitle: #6b7280;
  --color-tag: #0f766e;
  --color-card-shadow: rgba(16, 24, 40, 0.04);
  --color-primary-ghost: #374151;
  --color-danger: #dc2626;
}

/* 主题：默认蓝 */
.theme-default { }

/* 主题：暗夜黑 */
.theme-dark {
  --bg-page: #1a1a2e;
  --bg-card: #232340;
  --bg-hero: linear-gradient(135deg, #2d2d5e 0%, #1a1a3e 100%);
  --bg-chip: #2d2d5e;
  --bg-ghost: #2d2d5e;
  --bg-tab: #2d2d5e;
  --bg-input: #2a2a4a;
  --bg-step: #2d2d5e;
  --bg-tag: #1a3a3a;
  --bg-feature1: #2d2d5e;
  --bg-feature2: #1a3a3a;
  --bg-feature3: #2d2050;
  --bg-feature4: #3a3520;
  --bg-divider: #3a3a5c;
  --bg-border: #3a3a5c;
  --bg-chunk-border: #2d2d50;
  --color-primary: #818cf8;
  --color-text: #e2e8f0;
  --color-text-bold: #f1f5f9;
  --color-subtitle: #94a3b8;
  --color-tag: #5eead4;
  --color-card-shadow: rgba(0, 0, 0, 0.3);
  --color-primary-ghost: #c7d2fe;
  --color-danger: #f87171;
}

/* 主题：暖橙 */
.theme-warm {
  --bg-page: #fff8f3;
  --bg-card: #ffffff;
  --bg-hero: linear-gradient(135deg, #fff0e6 0%, #fff5f0 100%);
  --bg-chip: #fff0e6;
  --bg-ghost: #fff0e6;
  --bg-tab: #fff0e6;
  --bg-input: #ffffff;
  --bg-step: #fff0e6;
  --bg-tag: #e8f8f5;
  --bg-feature1: #fff0e6;
  --bg-feature2: #e8f8f5;
  --bg-feature3: #f0e6ff;
  --bg-feature4: #fff8e1;
  --bg-divider: #ffe0d6;
  --bg-border: #ffe0d6;
  --bg-chunk-border: #fff0e6;
  --color-primary: #f97316;
  --color-text: #2d3436;
  --color-text-bold: #1a1a1a;
  --color-subtitle: #999999;
  --color-tag: #0f766e;
  --color-card-shadow: rgba(255, 107, 107, 0.06);
  --color-primary-ghost: #7c2d12;
  --color-danger: #ea580c;
}

/* 主题：极简灰 */
.theme-minimal {
  --bg-page: #fafafa;
  --bg-card: #ffffff;
  --bg-hero: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  --bg-chip: #f5f5f5;
  --bg-ghost: #f5f5f5;
  --bg-tab: #f5f5f5;
  --bg-input: #ffffff;
  --bg-step: #f5f5f5;
  --bg-tag: #f0f0f0;
  --bg-feature1: #f5f5f5;
  --bg-feature2: #f0f0f0;
  --bg-feature3: #ebebeb;
  --bg-feature4: #f8f8f8;
  --bg-divider: #e0e0e0;
  --bg-border: #e0e0e0;
  --bg-chunk-border: #eeeeee;
  --color-primary: #404040;
  --color-text: #262626;
  --color-text-bold: #141414;
  --color-subtitle: #8c8c8c;
  --color-tag: #525252;
  --color-card-shadow: rgba(0, 0, 0, 0.04);
  --color-primary-ghost: #404040;
  --color-danger: #dc2626;
}

/* ========== 基础样式（使用变量） ========== */
page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: var(--bg-page);
  color: var(--color-text);
}
.container {
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx var(--color-card-shadow);
}
.hero-card {
  background: var(--bg-hero);
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 26rpx;
  color: var(--color-subtitle);
}
.muted {
  color: var(--color-subtitle);
}
.primary {
  background: var(--color-primary);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 20rpx 28rpx;
  font-weight: 600;
}
.ghost {
  background: var(--bg-ghost);
  color: var(--color-primary);
  border-radius: 999rpx;
  padding: 20rpx 28rpx;
  font-weight: 600;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.grid3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.chip {
  display: inline-block;
  background: var(--bg-chip);
  color: var(--color-primary-ghost);
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.tag {
  display: inline-block;
  background: var(--bg-tag);
  color: var(--color-tag);
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx 0;
}
.label {
  font-size: 28rpx;
  color: var(--color-subtitle);
  margin-bottom: 12rpx;
}
.body-text {
  font-size: 28rpx;
  color: var(--color-text-bold);
  line-height: 1.7;
  overflow-wrap: break-word;
}
.input {
  background: var(--bg-input);
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 0 rgba(0,0,0,0.02) inset;
  border: 1rpx solid var(--bg-border);
}
.textarea {
  width: 100%;
  min-height: 220rpx;
  background: var(--bg-input);
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--bg-border);
}
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.time {
  font-size: 24rpx;
  color: #6b7280;
  flex-shrink: 0;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.empty-card .btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 18rpx 26rpx;
}
.btn {
  display: inline-block;
  padding: 18rpx 26rpx;
}
.step {
  font-size: 28rpx;
  color: #111827;
  margin-bottom: 16rpx;
}
.source-card {
  margin-bottom: 12rpx;
}
.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  background: var(--bg-input);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--bg-border);
}
.search-clear {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: 26rpx;
  padding: 16rpx 20rpx;
}
.tabs {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: var(--bg-tab);
  color: var(--color-primary);
  font-weight: 600;
}
.tab.active {
  background: var(--color-primary);
  color: #ffffff;
}
.action-link {
  color: var(--color-primary);
  font-size: 26rpx;
  flex-shrink: 0;
}
.chunk-item {
  margin-bottom: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--bg-chunk-border);
}
.chunk-item:last-child {
  border-bottom: none;
}
.icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.icon-sm {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.icon-lg {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.icon-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.icon-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.icon-card .icon-lg {
  margin-bottom: 4rpx;
}
.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.feature-icon image {
  width: 44rpx;
  height: 44rpx;
}
.fi-blue { background: var(--bg-feature1); }
.fi-cyan { background: var(--bg-feature2); }
.fi-purple { background: var(--bg-feature3); }
.fi-amber { background: var(--bg-feature4); }
.step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-step);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.step-icon image {
  width: 28rpx;
  height: 28rpx;
}
.step-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-text-bold);
  margin-bottom: 20rpx;
}
.stat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 8rpx;
}
.label-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 24rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-subtitle);
}
.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--bg-divider);
}
.text-danger {
  color: var(--color-danger);
}
