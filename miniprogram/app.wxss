/* ========== 主题变量 ========== */
page {
  /* 结构变量 */
  --radius-card: 16rpx;
  --radius-chip: 999rpx;
  --radius-btn: 999rpx;
  --radius-icon: 20rpx;
  --radius-input: 14rpx;
  --shadow-card: 0 6rpx 20rpx rgba(16, 24, 40, 0.04);
  --border-card: none;
  --hero-color: #ffffff;
  /* 颜色变量 */
  --bg-page: #f5f7fb;
  --bg-card: #ffffff;
  --bg-hero: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --bg-chip: #eef2ff;
  --bg-ghost: #eef2ff;
  --bg-tab: #eef2ff;
  --bg-input: #ffffff;
  --bg-step: #eef2ff;
  --bg-tag: #ecfeff;
  --bg-feature1: #eef2ff;
  --bg-feature2: #ecfeff;
  --bg-feature3: #f5f3ff;
  --bg-feature4: #fef3c7;
  --bg-divider: #e5e7eb;
  --bg-border: #e5e7eb;
  --bg-chunk-border: #f3f4f6;
  --color-primary: #667eea;
  --color-primary-btn: linear-gradient(135deg, #667eea, #764ba2);
  --color-text: #1a1a2e;
  --color-text-bold: #1a1a2e;
  --color-subtitle: #888888;
  --color-tag: #0f766e;
  --color-card-shadow: rgba(102, 126, 234, 0.10);
  --color-primary-ghost: #4f6ef7;
  --color-danger: #dc2626;
  --color-hero-title: #ffffff;
}

/* 主题：默认蓝（精致立体风） */
.theme-default { }

/* 主题：暗夜黑 */
.container.theme-dark {
  --radius-card: 16rpx;
  --shadow-card: 0 6rpx 20rpx rgba(0, 0, 0, 0.5);
  --border-card: none;
  --bg-page: #000000;
  --bg-card: #1c1c1e;
  --bg-hero: linear-gradient(135deg, #4a5ae8 0%, #7c3aed 100%);
  --bg-chip: #2c2c2e;
  --bg-ghost: #2c2c2e;
  --bg-tab: #2c2c2e;
  --bg-input: #2c2c2e;
  --bg-step: #2c2c2e;
  --bg-tag: #1a3a3a;
  --bg-feature1: #2c2c2e;
  --bg-feature2: #1a3a3a;
  --bg-feature3: #2c2050;
  --bg-feature4: #3a3520;
  --bg-divider: #38383a;
  --bg-border: #38383a;
  --bg-chunk-border: #2c2c2e;
  --color-primary: #5e7ce2;
  --color-primary-btn: #5e7ce2;
  --color-text: #ffffff;
  --color-text-bold: #ffffff;
  --color-subtitle: #98989d;
  --color-tag: #64d2cf;
  --color-card-shadow: rgba(0, 0, 0, 0.5);
  --color-primary-ghost: #a8b4f0;
  --color-danger: #ff6b6b;
  --color-hero-title: #ffffff;
}

/* 主题：简约清爽风 */
.container.theme-clean {
  --radius-card: 24rpx;
  --radius-chip: 12rpx;
  --radius-btn: 20rpx;
  --radius-icon: 20rpx;
  --radius-input: 24rpx;
  --shadow-card: none;
  --border-card: 1rpx solid #e8e8ec;
  --bg-page: #f5f5f7;
  --bg-card: #ffffff;
  --bg-hero: #ffffff;
  --hero-color: #1d1d1f;
  --bg-chip: #f5f5f7;
  --bg-ghost: #f5f5f7;
  --bg-tab: #f5f5f7;
  --bg-input: #ffffff;
  --bg-step: #f5f5f7;
  --bg-tag: #e8e8ec;
  --bg-feature1: #e8f0fe;
  --bg-feature2: #e6f4ea;
  --bg-feature3: #f3e8fd;
  --bg-feature4: #fef7e0;
  --bg-divider: #e8e8ec;
  --bg-border: #e8e8ec;
  --bg-chunk-border: #f0f0f2;
  --color-primary: #0071e3;
  --color-primary-btn: #0071e3;
  --color-text: #1d1d1f;
  --color-text-bold: #1d1d1f;
  --color-subtitle: #86868b;
  --color-tag: #1d1d1f;
  --color-card-shadow: transparent;
  --color-primary-ghost: #1d1d1f;
  --color-danger: #dc2626;
  --color-hero-title: #1d1d1f;
}

/* 主题：活力暖色风 */
.container.theme-warm {
  --radius-card: 36rpx;
  --radius-chip: 999rpx;
  --radius-btn: 999rpx;
  --radius-icon: 28rpx;
  --radius-input: 28rpx;
  --shadow-card: 0 4rpx 32rpx rgba(255, 107, 107, 0.08);
  --border-card: none;
  --bg-page: #fff8f3;
  --bg-card: #ffffff;
  --bg-hero: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  --bg-chip: #fff0eb;
  --bg-ghost: #fff0eb;
  --bg-tab: #fff0eb;
  --bg-input: #ffffff;
  --bg-step: #fff0eb;
  --bg-tag: #e8f8f5;
  --bg-feature1: #fff0eb;
  --bg-feature2: #e8f8f5;
  --bg-feature3: #f0e6ff;
  --bg-feature4: #fff8e1;
  --bg-divider: #ffe0d6;
  --bg-border: #ffe0d6;
  --bg-chunk-border: #fff0e6;
  --color-primary: #ff6b6b;
  --color-primary-btn: linear-gradient(135deg, #ff6b6b, #ffa502);
  --color-text: #2d3436;
  --color-text-bold: #2d3436;
  --color-subtitle: #999999;
  --color-tag: #0f766e;
  --color-card-shadow: rgba(255, 107, 107, 0.08);
  --color-primary-ghost: #ff6b6b;
  --color-danger: #ea580c;
  --color-hero-title: #ffffff;
}

/* ========== 基础样式（使用变量） ========== */
page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--color-text);
}
/* 页面背景由主题决定 — 背景色呼应主色调，与卡片形成层次 */
page .theme-default { background: #eef2ff; }
page .theme-dark { background: #000000; }
page .theme-warm { background: #fff5ee; }
page .theme-clean { background: #f5f5f7; }
.container {
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: var(--border-card);
}
.hero-card {
  background: var(--bg-hero);
  border-radius: var(--radius-card);
}
.hero-card .title,
.hero-card .subtitle {
  color: var(--hero-color);
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 26rpx;
  color: var(--color-subtitle);
}
.muted {
  color: var(--color-subtitle);
}
.primary {
  background: var(--color-primary-btn);
  color: #ffffff;
  border-radius: var(--radius-btn);
  padding: 20rpx 28rpx;
  font-weight: 600;
}
.ghost {
  background: var(--bg-ghost);
  color: var(--color-primary);
  border-radius: var(--radius-btn);
  padding: 20rpx 28rpx;
  font-weight: 600;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.grid3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.chip {
  display: inline-block;
  background: var(--bg-chip);
  color: var(--color-primary-ghost);
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: var(--radius-chip);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.tag {
  display: inline-block;
  background: var(--bg-tag);
  color: var(--color-tag);
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: var(--radius-chip);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx 0;
}
.label {
  font-size: 28rpx;
  color: var(--color-subtitle);
  margin-bottom: 12rpx;
}
.body-text {
  font-size: 28rpx;
  color: var(--color-text-bold);
  line-height: 1.7;
  overflow-wrap: break-word;
}
.input {
  background: var(--bg-input);
  border-radius: var(--radius-input);
  padding: 20rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 0 rgba(0,0,0,0.02) inset;
  border: 1rpx solid var(--bg-border);
}
.textarea {
  width: 100%;
  min-height: 220rpx;
  background: var(--bg-input);
  border-radius: var(--radius-input);
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--bg-border);
}
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.time {
  font-size: 24rpx;
  color: var(--color-subtitle);
  flex-shrink: 0;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.empty-card .btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 18rpx 26rpx;
}
.btn {
  display: inline-block;
  padding: 18rpx 26rpx;
}
.step {
  font-size: 28rpx;
  color: var(--color-text-bold);
  margin-bottom: 16rpx;
}
.source-card {
  margin-bottom: 12rpx;
}
.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-subtitle);
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  background: var(--bg-input);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--bg-border);
}
.search-clear {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: 26rpx;
  padding: 16rpx 20rpx;
}
.tabs {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-input);
  background: var(--bg-tab);
  color: var(--color-primary);
  font-weight: 600;
}
.tab.active {
  background: var(--color-primary);
  color: #ffffff;
}
.action-link {
  color: var(--color-primary);
  font-size: 26rpx;
  flex-shrink: 0;
}
.chunk-item {
  margin-bottom: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--bg-chunk-border);
}
.chunk-item:last-child {
  border-bottom: none;
}
.icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.icon-sm {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.icon-lg {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.icon-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.icon-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.icon-card .icon-lg {
  margin-bottom: 4rpx;
}
.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-icon);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.feature-icon image {
  width: 44rpx;
  height: 44rpx;
}
.fi-blue { background: var(--bg-feature1); }
.fi-cyan { background: var(--bg-feature2); }
.fi-purple { background: var(--bg-feature3); }
.fi-amber { background: var(--bg-feature4); }
.step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-step);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.step-icon image {
  width: 28rpx;
  height: 28rpx;
}
.step-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-text-bold);
  margin-bottom: 20rpx;
}
.stat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 8rpx;
}
.label-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 24rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-subtitle);
}
.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--bg-divider);
}
.text-danger {
  color: var(--color-danger);
}

/* ========== 工具类（替代高频内联样式） ========== */
.mb-0 { margin-bottom: 0 !important; }
.mb-12 { margin-bottom: 12rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mr-8 { margin-right: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.w-full { width: 100%; }
.text-center { text-align: center; }
.flex-1 { flex: 1; min-width: 0; }
.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-btn .icon-sm { margin-right: 8rpx; }
.list-sub {
  margin-top: 8rpx;
  padding-left: 44rpx;
}
.list-sub-tags {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
  padding-left: 44rpx;
}
.detail-header {
  text-align: center;
  padding: 80rpx 24rpx;
}
.detail-actions {
  margin-top: 16rpx;
  width: 100%;
}
.input-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}
.input-row .flex-1 {
  justify-content: center;
}
