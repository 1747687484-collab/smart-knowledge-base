page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #f5f7fb;
  color: #1f2937;
}
.container {
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(16, 24, 40, 0.04);
}
.hero-card {
  background: linear-gradient(135deg, #eef2ff 0%, #f8fbff 100%);
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 26rpx;
  color: #6b7280;
}
.muted {
  color: #6b7280;
}
.primary {
  background: #2563eb;
  color: #ffffff;
  border-radius: 999rpx;
  padding: 20rpx 28rpx;
  font-weight: 600;
}
.ghost {
  background: #eef2ff;
  color: #2563eb;
  border-radius: 999rpx;
  padding: 20rpx 28rpx;
  font-weight: 600;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.grid3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.chip {
  display: inline-block;
  background: #eef2ff;
  color: #374151;
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.tag {
  display: inline-block;
  background: #ecfeff;
  color: #0f766e;
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx 0;
}
.label {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}
.body-text {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.7;
  overflow-wrap: break-word;
}
.input {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 0 rgba(0,0,0,0.02) inset;
  border: 1rpx solid #e5e7eb;
}
.textarea {
  width: 100%;
  min-height: 220rpx;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #e5e7eb;
}
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.time {
  font-size: 24rpx;
  color: #6b7280;
  flex-shrink: 0;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.empty-card .btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 18rpx 26rpx;
}
.btn {
  display: inline-block;
  padding: 18rpx 26rpx;
}
.step {
  font-size: 28rpx;
  color: #111827;
  margin-bottom: 16rpx;
}
.source-card {
  margin-bottom: 12rpx;
}
.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  border: 1rpx solid #e5e7eb;
}
.search-clear {
  flex-shrink: 0;
  color: #2563eb;
  font-size: 26rpx;
  padding: 16rpx 20rpx;
}
.tabs {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: #eef2ff;
  color: #2563eb;
  font-weight: 600;
}
.tab.active {
  background: #2563eb;
  color: #ffffff;
}
.action-link {
  color: #2563eb;
  font-size: 26rpx;
  flex-shrink: 0;
}
.chunk-item {
  margin-bottom: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.chunk-item:last-child {
  border-bottom: none;
}
.icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.icon-sm {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.icon-lg {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.icon-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.icon-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.icon-card .icon-lg {
  margin-bottom: 4rpx;
}
.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.feature-icon image {
  width: 44rpx;
  height: 44rpx;
}
.step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eef2ff;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.step-icon image {
  width: 28rpx;
  height: 28rpx;
}
.step-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #111827;
  margin-bottom: 20rpx;
}
.stat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 8rpx;
}
.label-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 24rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #2563eb;
}
.stat-label {
  font-size: 22rpx;
  color: #6b7280;
}
.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e5e7eb;
}
