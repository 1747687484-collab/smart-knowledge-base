<view class="container">
  <view class="card hero-card">
    <view class="row-between">
      <view class="icon-row">
        <image class="icon-lg" src="{{icons.note}}" mode="aspectFit" />
        <view>
          <view class="title">笔记</view>
          <view class="subtitle">记录想法、待办、会议要点和临时信息</view>
        </view>
      </view>
      <navigator class="primary btn icon-row" url="/pages/note-detail/note-detail">
        <image class="icon-sm" src="{{icons.note}}" mode="aspectFit" style="margin-right:8rpx;" />
        新建
      </navigator>
    </view>
  </view>

  <view class="search-bar">
    <image class="icon-sm" src="{{icons.search}}" mode="aspectFit" style="margin-left:16rpx;" />
    <input class="search-input" placeholder="搜索笔记标题或内容" value="{{searchKey}}" bindinput="onSearchInput" bindconfirm="onSearch" />
    <view class="search-clear" wx:if="{{searchKey}}" bindtap="onSearchClear">清除</view>
  </view>

  <view class="section-title" wx:if="{{list.length}}">全部笔记</view>
  <block wx:if="{{list.length}}">
    <navigator class="card" wx:for="{{list}}" wx:key="id" url="/pages/note-detail/note-detail?id={{item.id}}">
      <view class="row-between">
        <view class="icon-row" style="flex:1;min-width:0;">
          <image class="icon-sm" src="{{icons.note}}" mode="aspectFit" />
          <view class="title ellipsis" style="flex:1;">{{item.pinned ? '📌 ' : ''}}{{item.starred ? '★ ' : ''}}{{item.titleHL || item.title || '未命名笔记'}}</view>
        </view>
        <view class="time muted">{{item.updatedText}}</view>
      </view>
      <view class="subtitle ellipsis" style="margin-top:8rpx;padding-left:44rpx;">{{item.previewHL || item.preview}}</view>
      <view style="margin-top: 8rpx; display:flex; gap: 12rpx;padding-left:44rpx;">
        <text class="action-link icon-row" bindtap="onStar" data-id="{{item.id}}">
          <image class="icon-sm" src="{{icons.star}}" mode="aspectFit" />
          {{item.starred ? '取消星标' : '星标'}}
        </text>
        <text class="action-link icon-row" bindtap="onPin" data-id="{{item.id}}">
          <image class="icon-sm" src="{{icons.pin}}" mode="aspectFit" />
          {{item.pinned ? '取消置顶' : '置顶'}}
        </text>
      </view>
    </navigator>
  </block>
  <view wx:else class="card empty-card">
    <view class="icon-row">
      <image class="icon" src="{{icons.note}}" mode="aspectFit" />
      <view class="title">还没有笔记</view>
    </view>
    <view class="subtitle">先记录一条备忘、待办或会议纪要</view>
    <navigator class="primary btn" url="/pages/note-detail/note-detail">新建第一条笔记</navigator>
  </view>
</view>
