.theme-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.theme-option {
  border-radius: 16rpx;
  padding: 16rpx;
  text-align: center;
  border: 2rpx solid var(--bg-border);
  transition: border-color 0.2s;
}
.theme-active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx var(--color-primary);
  background: var(--bg-chip);
}
.theme-preview {
  height: 120rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  position: relative;
}
.tp-bar {
  height: 16rpx;
}
.tp-hero {
  height: 28rpx;
  margin: 6rpx 10rpx;
  border-radius: 6rpx;
}
.tp-row {
  display: flex;
  gap: 6rpx;
  padding: 0 10rpx;
}
.tp-card {
  flex: 1;
  height: 40rpx;
  border-radius: 6rpx;
}

/* 精致立体预览 */
.theme-preview-default { background: #f2f4f8; }
.theme-preview-default .tp-bar { background: linear-gradient(135deg, #667eea, #764ba2); }
.theme-preview-default .tp-hero { background: linear-gradient(135deg, #667eea, #764ba2); }
.theme-preview-default .tp-card { background: #fff; box-shadow: 0 2rpx 12rpx rgba(102,126,234,0.12); border-radius: 14rpx; }

/* 暗夜黑预览 */
.theme-preview-dark { background: #000000; }
.theme-preview-dark .tp-bar { background: linear-gradient(135deg, #4a5ae8, #7c3aed); }
.theme-preview-dark .tp-hero { background: linear-gradient(135deg, #4a5ae8, #7c3aed); }
.theme-preview-dark .tp-card { background: #1c1c1e; border-radius: 14rpx; }

/* 简约清爽预览 */
.theme-preview-clean { background: #fafbfc; }
.theme-preview-clean .tp-bar { background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.theme-preview-clean .tp-hero { background: #fff; border: 1rpx solid #f0f0f0; }
.theme-preview-clean .tp-card { background: #fff; border: 1rpx solid #f0f0f0; border-radius: 12rpx; }

/* 活力暖色预览 */
.theme-preview-warm { background: #fff8f3; }
.theme-preview-warm .tp-bar { background: linear-gradient(135deg, #ff6b6b, #ffa502); }
.theme-preview-warm .tp-hero { background: linear-gradient(135deg, #ff9a9e, #fecfef); }
.theme-preview-warm .tp-card { background: #fff; box-shadow: 0 2rpx 16rpx rgba(255,107,107,0.1); border-radius: 18rpx; }

.theme-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-bold);
}
.theme-desc {
  font-size: 20rpx;
  color: var(--color-subtitle);
  margin-top: 4rpx;
}
