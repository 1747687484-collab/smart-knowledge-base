.scope-tag {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}
.scope-switch {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.switch-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: var(--bg-tab);
  color: var(--color-primary);
  font-weight: 600;
}
.switch-item.active {
  background: var(--color-primary);
  color: var(--color-hero-title);
}
