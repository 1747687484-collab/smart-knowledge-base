.graph-board {
  position: relative;
  width: 100%;
  height: 660rpx;
  background: var(--bg-page);
  border-radius: 20rpx;
  overflow: hidden;
}
.graph-node {
  position: absolute;
  min-width: 120rpx;
  padding: 16rpx 18rpx;
  background: var(--bg-card);
  border-radius: 999rpx;
  color: var(--color-text-bold);
  font-size: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 22rpx var(--color-card-shadow);
  z-index: 1;
}
.graph-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
