<view class="container {{themeClass}}">
  <view class="card hero-card">
    <view class="row-between">
      <view class="icon-row">
        <image class="icon-lg" src="{{icons.brain}}" mode="aspectFit" />
        <view>
          <view class="title">智能知识库</view>
          <view class="subtitle">上传资料、自动整理、形成知识结构</view>
        </view>
      </view>
      <navigator class="icon-row" url="/pages/settings/settings">
        <image class="icon" src="{{icons.settings}}" mode="aspectFit" />
      </navigator>
    </view>
  </view>

  <view class="grid2">
    <navigator class="card icon-card" url="/pages/documents/documents" aria-label="文档管理">
      <view class="feature-icon fi-blue">
        <image src="{{icons.doc}}" mode="aspectFit" aria-label="文档图标" />
      </view>
      <view class="title">文档</view>
      <view class="subtitle">上传报告、资料、合同</view>
    </navigator>
    <navigator class="card icon-card" url="/pages/notes/notes" aria-label="笔记管理">
      <view class="feature-icon fi-cyan">
        <image src="{{icons.note}}" mode="aspectFit" aria-label="笔记图标" />
      </view>
      <view class="title">笔记</view>
      <view class="subtitle">记录想法、待办、临时信息</view>
    </navigator>
    <navigator class="card icon-card" url="/pages/qa/qa" aria-label="智能问答">
      <view class="feature-icon fi-purple">
        <image src="{{icons.qa}}" mode="aspectFit" aria-label="问答图标" />
      </view>
      <view class="title">问答</view>
      <view class="subtitle">基于已有内容提问</view>
    </navigator>
    <navigator class="card icon-card" url="/pages/graph/graph" aria-label="知识图谱">
      <view class="feature-icon fi-amber">
        <image src="{{icons.graph}}" mode="aspectFit" aria-label="图谱图标" />
      </view>
      <view class="title">图谱</view>
      <view class="subtitle">查看实体、关系和结构</view>
    </navigator>
  </view>

  <view class="card stats-bar" wx:if="{{docCount + noteCount > 0}}">
    <view class="stat-item">
      <view class="stat-num">{{docCount}}</view>
      <view class="stat-label">文档</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{noteCount}}</view>
      <view class="stat-label">笔记</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{qaCount}}</view>
      <view class="stat-label">问答</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{tagCount}}</view>
      <view class="stat-label">标签</view>
    </view>
  </view>

  <view class="section-title">最近文档</view>
  <block wx:if="{{docs.length}}">
    <navigator class="card" wx:for="{{docs}}" wx:key="id" url="/pages/document-detail/document-detail?id={{item.id}}&type=doc">
      <view class="row-between">
        <view class="icon-row" style="flex:1;min-width:0;">
          <image class="icon-sm" src="{{icons.doc}}" mode="aspectFit" />
          <view class="title ellipsis" style="flex:1;">{{item.title || '未命名文档'}}</view>
        </view>
        <view class="time muted">{{item.updatedText}}</view>
      </view>
      <view class="subtitle ellipsis" style="margin-top:8rpx;padding-left:44rpx;">摘要：{{item.preview || '保存后自动生成'}}</view>
    </navigator>
  </block>
  <view wx:else class="card empty-card">
    <view class="icon-row">
      <image class="icon" src="{{icons.doc}}" mode="aspectFit" />
      <view class="title">还没有文档</view>
    </view>
    <view class="subtitle">先上传资料或粘贴文本，快速体验文档智能整理</view>
    <navigator class="primary btn" url="/pages/documents/documents">去上传文档</navigator>
  </view>

  <view class="section-title">最近笔记</view>
  <block wx:if="{{notes.length}}">
    <navigator class="card" wx:for="{{notes}}" wx:key="id" url="/pages/note-detail/note-detail?id={{item.id}}&type=note">
      <view class="row-between">
        <view class="icon-row" style="flex:1;min-width:0;">
          <image class="icon-sm" src="{{icons.note}}" mode="aspectFit" />
          <view class="title ellipsis" style="flex:1;">{{item.title || '未命名笔记'}}</view>
        </view>
        <view class="time muted">{{item.updatedText}}</view>
      </view>
      <view class="subtitle ellipsis" style="margin-top:8rpx;padding-left:44rpx;">摘要：{{item.preview || '保存后自动生成'}}</view>
    </navigator>
  </block>
  <view wx:else class="card empty-card">
    <view class="icon-row">
      <image class="icon" src="{{icons.note}}" mode="aspectFit" />
      <view class="title">还没有笔记</view>
    </view>
    <view class="subtitle">先记录一条备忘、会议纪要或待办</view>
    <navigator class="primary btn" url="/pages/note-detail/note-detail">去新建笔记</navigator>
  </view>

  <view class="section-title">快速使用</view>
  <view class="card">
    <view class="step-row">
      <view class="step-icon"><image src="{{icons.zap}}" mode="aspectFit" /></view>
      上传文档或粘贴文本
    </view>
    <view class="step-row">
      <view class="step-icon"><image src="{{icons.brain}}" mode="aspectFit" /></view>
      自动生成摘要、标签与知识切片
    </view>
    <view class="step-row" style="margin-bottom:0;">
      <view class="step-icon"><image src="{{icons.qa}}" mode="aspectFit" /></view>
      在问答页向知识库提问
    </view>
  </view>
</view>
